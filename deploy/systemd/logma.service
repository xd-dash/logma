[Unit]
Description=Logma API server
Documentation=https://github.com/xd-dash/logma
After=network.target

[Service]
Type=simple
User=logma
Group=logma
EnvironmentFile=/etc/logma/logma.env
ExecStart=/usr/local/bin/logma ${PORT}
Restart=on-failure
RestartSec=5s

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
