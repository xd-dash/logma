PORT=8080

# Prefer the colocated Marai Unix socket.
REDIS_SOCKET=/run/marai/redis.sock
REDIS_USERNAME=marai-logma
REDISCLI_AUTH=
REDIS_DB=1

# Marai encrypted cache settings.
MARAI_CACHE_DB=1
MARAI_KMS_KEY_ID=logma
MARAI_CACHE_NAMESPACE=logma

API_KEY=

PUBSUB_DEFAULT_CALLBACK_URL=
PUBSUB_DEFAULT_CALLBACK_TOKEN=
PUBSUB_DEFAULT_CALLBACK_TOKEN_SCHEME=Bearer

DEFAULT_AXIOM_URL=
DEFAULT_AXIOM_TOKEN=
DEFAULT_AXIOM_TOKEN_SCHEME=Bearer
